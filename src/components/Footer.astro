---
import { site, nav, products } from '../data/site';
import { url } from '../utils';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
const year = 2026; // build sabiti
const socials = [
  { key: 'instagram', icon: 'instagram', href: site.social.instagram },
  { key: 'linkedin', icon: 'linkedin', href: site.social.linkedin },
  { key: 'youtube', icon: 'youtube', href: site.social.youtube },
].filter((s) => s.href);
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand" href={url('/')} aria-label={`${site.name} anasayfa`}>
          <Logo class="brand-logo" />
        </a>
        <p class="mt-2" style="max-width:34ch; color:#a9c0b3;">{site.description}</p>
        {socials.length > 0 && (
          <div class="footer-social">
            {socials.map((s) => (
              <a href={s.href} target="_blank" rel="noopener" aria-label={s.key}><Icon name={s.icon} /></a>
            ))}
          </div>
        )}
      </div>

      <div>
        <h4>Kurumsal</h4>
        <ul class="f-links">
          {nav.map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}
        </ul>
      </div>

      <div>
        <h4>Ürünlerimiz</h4>
        <ul class="f-links">
          {products.slice(0, 6).map((s) => (
            <li><a href={url(`/urunler#${s.slug}`)}>{s.title}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4>İletişim</h4>
        <ul class="footer-contact">
          <li><Icon name="pin" /><span>{site.address.full}</span></li>
          <li><Icon name="phone" /><a href={site.phoneHref}>{site.phone}</a></li>
          <li><Icon name="mail" /><a href={site.emailHref}>{site.email}</a></li>
          <li><Icon name="clock" /><span>{site.hours[0].day}: {site.hours[0].time}</span></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} {site.legalName}. Tüm hakları saklıdır.</span>
      <span>{site.address.city}, {site.address.country} · Akıllı tarım çözümleri</span>
    </div>
  </div>
</footer>
