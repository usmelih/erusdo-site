---
import { nav, site } from '../data/site';
import { url } from '../utils';
import Icon from './Icon.astro';
const current = Astro.url.pathname.replace(/\/$/, '') || url('/');
function isActive(href: string) {
  const target = url(href).replace(/\/$/, '');
  if (href === '/') return current === target || current === url('/').replace(/\/$/, '');
  return current.startsWith(target);
}
---
<header class="site-header" id="siteHeader">
  <div class="container header-inner">
    <a class="brand" href={url('/')} aria-label="Erusdo anasayfa">
      <svg class="mark" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="40" height="40" rx="11" fill="#15623f"/>
        <path d="M20 9c-6 0-11 4-11 11 0 6 4 11 11 11 0-5 0-11-7-15 6 1 9 4 11 8 1-1 1-3 1-4 0-6-4-11-5-11Z" fill="#9cc23f"/>
        <path d="M20 31V18" stroke="#eef5dd" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
      <span>{site.name}<small>{site.tagline}</small></span>
    </a>

    <nav class="nav" aria-label="Ana menü">
      {nav.map((item) => (
        <a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="header-cta">
      <a class="btn btn-primary" href={url('/iletisim')}>Teklif Al</a>
    </div>

    <button class="nav-toggle" id="navToggle" aria-label="Menüyü aç/kapat" aria-expanded="false">
      <Icon name="menu" />
    </button>
  </div>
</header>

<script>
  const header = document.getElementById('siteHeader');
  const toggle = document.getElementById('navToggle');
  toggle?.addEventListener('click', () => {
    const open = header?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(!!open));
  });
</script>
