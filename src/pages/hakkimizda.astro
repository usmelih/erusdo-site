---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site, stats } from '../data/site';
import { url } from '../utils';

const values = [
  { icon: 'shield', title: 'Sağlık & Hijyen', text: 'Sofraya gelen her ürünün temiz, güvenli ve kalıntısız olması bizim için pazarlık konusu değildir.' },
  { icon: 'target', title: 'Kalitede Süreklilik', text: 'Yıl boyu aynı tazelik, aynı standart. Alıcılarımız her teslimatta aynı kaliteyi bulacağını bilir.' },
  { icon: 'seedling', title: 'Sürdürülebilirlik', text: 'Damla sulamayla suyu koruyan, doğaya saygılı kokopit üretimi. Bugünün ürünü, yarının kaynağından çalmamalı.' },
  { icon: 'users', title: 'Güvenilir Tedarik', text: 'Sözümüzün arkasında dururuz. Zamanında, eksiksiz ve düzenli tedarik işimizin temelidir.' },
];
const team = [
  { name: 'Üretim & Agronomi', role: 'Yetiştirme ve bitki sağlığı', initials: 'ÜA' },
  { name: 'Sera Ekibi', role: 'Bakım ve iklim yönetimi', initials: 'SE' },
  { name: 'Hasat & Sevkiyat', role: 'Paketleme ve teslimat', initials: 'HS' },
];
---
<BaseLayout title="Hakkımızda" description="Erusdo, Çine/Aydın'da kokopit substratında topraksız tarım yöntemiyle taze ve hijyenik sebze-meyve üreten bir aile üreticisidir. Hikayemizi ve değerlerimizi keşfedin.">
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb"><a href={url('/')}>Anasayfa</a> / Hakkımızda</div>
      <span class="eyebrow">Hakkımızda</span>
      <h1 class="mt-2">Toprağa değil, özene dayanan üretim</h1>
      <p class="lead mt-2" style="max-width:62ch">
        Erusdo, Çine/Aydın’da modern seralarında kokopit ile topraksız tarım
        yöntemiyle taze ve hijyenik sebze-meyve üreten bir üreticidir. Amacımız net:
        sofralara en temiz, en taze ve en lezzetli ürünü ulaştırmak.
      </p>
    </div>
  </section>

  <!-- HİKAYE -->
  <section class="section">
    <div class="container">
      <div class="grid stack-mobile" style="grid-template-columns:1.1fr 0.9fr; gap:56px; align-items:center;">
        <div class="prose" style="font-size:1.08rem">
          <h2>Daha temiz bir ürün arayışıyla başladık</h2>
          <p>
            Erusdo’nun hikayesi basit bir inançla başladı: insanlar daha temiz,
            daha taze ve daha güvenli ürün hak ediyor. Geleneksel tarımın
            getirdiği toprak kaynaklı riskler ve kalıntı endişesi, bizi farklı
            bir yol aramaya itti.
          </p>
          <p>
            {site.foundingYear} yılından bu yana, modern seralarımızda kokopit
            (hindistan cevizi torfu) substratında topraksız tarım yöntemiyle üretim
            yapıyoruz. Suyu ve besini kontrol ederek; daha az ilaçla, kalıntısız ve
            yıl boyu aynı kalitede sebze ve meyve yetiştiriyoruz.
          </p>
          <p>
            Bizim için başarı; ürünümüzü alan bir ailenin “bu gerçekten taze ve
            temiz” demesi, bir esnafın bize güvenerek tedariğini sürdürmesidir.
          </p>
        </div>
        <div class="card" style="background:linear-gradient(160deg,var(--primary-700),#0a2c1c); color:#fff; border:none;">
          <h3 style="color:#fff">Misyonumuz</h3>
          <p style="color:#cfe0d5; margin-bottom:24px">
            Kokopit ile topraksız tarımın gücüyle; hijyenik, kalıntısız ve taze
            ürünleri herkes için erişilebilir kılmak.
          </p>
          <h3 style="color:#fff">Vizyonumuz</h3>
          <p style="color:#cfe0d5">
            Bölgemizde sürdürülebilir ve güvenilir sera üretiminin örnek
            gösterilen markası olmak.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- İSTATİSTİK -->
  <section class="section-sm bg-dark">
    <div class="container">
      <div class="stats">
        {stats.map((s) => <div class="stat"><b>{s.value}</b><span>{s.label}</span></div>)}
      </div>
    </div>
  </section>

  <!-- DEĞERLER -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Değerlerimiz</span>
        <h2>Bizi biz yapan ilkeler</h2>
      </div>
      <div class="grid cols-4">
        {values.map((v) => (
          <div class="card">
            <div class="card-icon"><Icon name={v.icon} /></div>
            <h3 style="font-size:1.12rem">{v.title}</h3>
            <p>{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- EKİP -->
  <section class="section bg-soft">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Ekibimiz</span>
        <h2>Üretimin her aşamasında özen</h2>
        <p>Fideden hasada, paketlemeden teslimata kadar her aşamada tek bir amaç için çalışıyoruz: en taze ve en temiz ürün.</p>
      </div>
      <div class="grid cols-3">
        {team.map((t) => (
          <div class="card center">
            <div style="width:84px;height:84px;border-radius:24px;background:var(--primary-tint);color:var(--primary);display:grid;place-items:center;margin:0 auto 16px;font-family:var(--font-head);font-weight:800;font-size:1.4rem">{t.initials}</div>
            <h3 style="font-size:1.2rem">{t.name}</h3>
            <p class="muted">{t.role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-band">
        <h2>Taze ürün, güvenilir tedarik</h2>
        <p>Market, manav, restoran ve toptan alıcılar için düzenli ve standart kalitede tedarik sağlıyoruz. Tanışalım, ihtiyacınızı birlikte planlayalım.</p>
        <a class="btn btn-white btn-lg" href={url('/iletisim')}>İletişime geçin</a>
      </div>
    </div>
  </section>
</BaseLayout>
