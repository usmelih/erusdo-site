---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { url } from '../utils';

const advantages = [
  { icon: 'shield', title: 'Daha Hijyenik', text: 'Bitki toprakla temas etmediği için topraktan bulaşan hastalık ve kirleticiler ortadan kalkar. Sonuç: tertemiz, güvenli ürün.' },
  { icon: 'droplet', title: 'Çok Daha Az Su', text: 'Kapalı devre sistemde su geri kazanılır; geleneksel tarıma göre %90’a varan su tasarrufu sağlanır.' },
  { icon: 'seedling', title: 'Dengeli Beslenme', text: 'Her bitki, ihtiyaç duyduğu besini tam ölçüsünde alır. Bu da daha sağlıklı, daha lezzetli ve standart kalitede ürün demektir.' },
  { icon: 'sun', title: 'Yıl Boyu Üretim', text: 'Kontrollü sera ortamı sayesinde mevsimden bağımsız, 12 ay boyunca taze hasat yapılır.' },
  { icon: 'leaf', title: 'Az İlaç, Kalıntısız', text: 'Kontrollü ortam zararlı baskısını düşürür; çok daha az ilaçla, kalıntısız üretim mümkün olur.' },
  { icon: 'chart', title: 'Yüksek & Stabil Verim', text: 'Optimum koşullar, birim alandan daha yüksek ve istikrarlı verim sağlar; tedarikte süreklilik garanti altına alınır.' },
];

const steps = [
  { title: 'Fide Hazırlığı', text: 'Hastalıksız, güçlü fidelerle başlıyoruz. Doğru çeşit seçimi kaliteli hasadın temelidir.' },
  { title: 'Topraksız Yerleştirme', text: 'Fideler, kök bölgesini destekleyen inert ortamlara (ör. kokopit, perlit) yerleştirilir; toprak kullanılmaz.' },
  { title: 'Besin Çözeltisi Yönetimi', text: 'Su ve bitki besinleri, doğru oran ve zamanlamayla kök bölgesine verilir. Beslenme sürekli izlenir ve dengelenir.' },
  { title: 'Kontrollü Sera İklimi', text: 'Sıcaklık, nem ve havalandırma optimum aralıkta tutulur; bitki her zaman ideal koşullarda büyür.' },
  { title: 'Bitki Sağlığı Takibi', text: 'Bitkiler düzenli kontrol edilir; sorunlar büyümeden, çevreci yöntemlerle ele alınır.' },
  { title: 'Hijyenik Hasat & Paketleme', text: 'Ürünler en taze hâliyle toplanır, hijyen kurallarına uygun paketlenir ve hızla sevk edilir.' },
];
---
<BaseLayout title="Üretim Yöntemimiz — Topraksız (Hidroponik) Tarım" description="Erusdo, topraksız (hidroponik) tarım yöntemiyle üretim yapar. Topraksız tarımın ne olduğunu, sürecimizi ve sağladığı hijyen, lezzet ve sürdürülebilirlik avantajlarını anlattık.">
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb"><a href={url('/')}>Anasayfa</a> / Üretim Yöntemimiz</div>
      <span class="eyebrow">Üretim Yöntemimiz</span>
      <h1 class="mt-2">Topraksız (Hidroponik) Tarım</h1>
      <p class="lead mt-2" style="max-width:62ch">
        Ürünlerimizi toprak kullanmadan, su ve besinleri kontrol ederek
        yetiştiriyoruz. Bu yöntem; daha hijyenik, daha lezzetli ve daha
        sürdürülebilir bir üretim demektir.
      </p>
    </div>
  </section>

  <!-- TOPRAKSIZ TARIM NEDİR -->
  <section class="section">
    <div class="container">
      <div class="grid" style="grid-template-columns:1.1fr 0.9fr; gap:56px; align-items:center;">
        <div class="prose" style="font-size:1.08rem">
          <h2>Topraksız tarım nedir?</h2>
          <p>
            Topraksız tarım (hidroponik), bitkilerin toprak yerine; suya çözünmüş
            dengeli besinlerle, kontrollü bir ortamda yetiştirildiği modern bir
            üretim yöntemidir. Bitkinin kökü, ihtiyaç duyduğu su ve besine tam
            ölçüsünde ulaşır.
          </p>
          <p>
            Toprak devreden çıktığı için topraktan kaynaklanan hastalıklar,
            yabancı otlar ve kirleticiler ortadan kalkar. Bu da çok daha az
            ilaçla, kalıntısız ve hijyenik üretim anlamına gelir.
          </p>
          <p>
            Biz Erusdo olarak bu yöntemi, kontrollü sera ortamıyla birleştirerek
            yıl boyu standart kalitede, taze sebze ve meyve üretiyoruz.
          </p>
        </div>
        <div class="card" style="background:linear-gradient(160deg,var(--primary-700),#0a2c1c); color:#fff; border:none;">
          <h3 style="color:#fff">Kısaca topraksız tarım</h3>
          <ul class="ticks mt-2" style="--c:#fff">
            <li style="color:#dceee3">Toprak yok, kontrollü besleme var</li>
            <li style="color:#dceee3">%90’a varan su tasarrufu</li>
            <li style="color:#dceee3">Daha az ilaç, kalıntısız ürün</li>
            <li style="color:#dceee3">Yıl boyu taze hasat</li>
            <li style="color:#dceee3">Hijyenik ve sürdürülebilir</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- AVANTAJLAR -->
  <section class="section bg-soft">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Neden Topraksız?</span>
        <h2>Topraksız tarımın avantajları</h2>
        <p>Bu yöntem hem ürün kalitesini hem de doğayı koruyor.</p>
      </div>
      <div class="grid cols-3">
        {advantages.map((a) => (
          <div class="card">
            <div class="card-icon"><Icon name={a.icon} /></div>
            <h3 style="font-size:1.15rem">{a.title}</h3>
            <p>{a.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SÜREÇ -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Adım Adım</span>
        <h2>Fideden hasada üretim sürecimiz</h2>
        <p>Her ürün, kalite ve hijyenin garanti altına alındığı titiz bir süreçten geçer.</p>
      </div>
      <div class="grid cols-2" style="gap:14px 40px">
        <div class="steps">
          {steps.slice(0, 3).map((s) => (
            <div class="step">
              <div class="num"></div>
              <div><h3 style="font-size:1.15rem;margin-bottom:6px">{s.title}</h3><p class="muted">{s.text}</p></div>
            </div>
          ))}
        </div>
        <div class="steps" style="counter-reset: step 3">
          {steps.slice(3).map((s) => (
            <div class="step">
              <div class="num"></div>
              <div><h3 style="font-size:1.15rem;margin-bottom:6px">{s.title}</h3><p class="muted">{s.text}</p></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-soft">
    <div class="container">
      <div class="cta-band">
        <h2>Üretim seralarımızı yakından tanıyın</h2>
        <p>Ürünlerimiz ve tedarik koşulları hakkında bilgi almak, sipariş vermek ya da iş birliği için bizimle iletişime geçin.</p>
        <div class="flex gap-2 wrap" style="justify-content:center">
          <a class="btn btn-white btn-lg" href={url('/urunler')}>Ürünlerimizi Gör</a>
          <a class="btn btn-lg" href={url('/iletisim')} style="background:rgba(255,255,255,.14);color:#fff;border-color:rgba(255,255,255,.3)">İletişime Geç</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
