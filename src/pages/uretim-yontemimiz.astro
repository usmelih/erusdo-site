---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { url } from '../utils';

const advantages = [
  { icon: 'shield', title: 'Daha Hijyenik', text: 'Bitki tarla toprağıyla temas etmediği için topraktan bulaşan hastalık, yabancı ot ve kirleticiler ortadan kalkar. Sonuç: tertemiz, güvenli ürün.' },
  { icon: 'droplet', title: 'Su Verimli', text: 'Kokopitin yüksek su tutma kapasitesi ve damla sulama sayesinde su ve besin doğrudan köke, ölçülü verilir; israf en aza iner.' },
  { icon: 'seedling', title: 'Dengeli Beslenme', text: 'Kök bölgesine verilen besin çözeltisi sürekli izlenir. Her bitki ihtiyacı kadar beslenir; daha sağlıklı, lezzetli ve standart kalitede ürün elde edilir.' },
  { icon: 'sun', title: 'Yıl Boyu Üretim', text: 'Kontrollü sera ortamı sayesinde mevsimden bağımsız, 12 ay boyunca taze hasat yapılır.' },
  { icon: 'leaf', title: 'Az İlaç, Kalıntısız', text: 'Steril başlangıç ve kontrollü ortam zararlı baskısını düşürür; çok daha az ilaçla, kalıntısız üretim mümkün olur.' },
  { icon: 'chart', title: 'Yüksek & Stabil Verim', text: 'Köke uygun havalanma ve dengeli beslenme, birim alandan daha yüksek ve istikrarlı verim sağlar; tedarikte süreklilik garanti altına alınır.' },
];

const steps = [
  { title: 'Fide Hazırlığı', text: 'Hastalıksız, güçlü fidelerle başlıyoruz. Doğru çeşit seçimi kaliteli hasadın temelidir.' },
  { title: 'Kokopite Dikim', text: 'Fideler, tarla toprağı yerine kokopit (hindistan cevizi torfu) dolu torba ve saksılara dikilir. Kokopit, kökü destekler; suyu ve havayı dengede tutar.' },
  { title: 'Damla Sulama ile Besleme', text: 'Su ve bitki besinleri, damla sulama hatlarıyla doğru oran ve zamanlamada doğrudan kök bölgesine verilir. Beslenme sürekli izlenir ve dengelenir.' },
  { title: 'Kontrollü Sera İklimi', text: 'Sıcaklık, nem ve havalandırma optimum aralıkta tutulur; bitki her zaman ideal koşullarda büyür.' },
  { title: 'Bitki Sağlığı Takibi', text: 'Bitkiler düzenli kontrol edilir; sorunlar büyümeden, çevreci yöntemlerle ele alınır.' },
  { title: 'Hijyenik Hasat & Paketleme', text: 'Ürünler en taze hâliyle toplanır, hijyen kurallarına uygun paketlenir ve hızla sevk edilir.' },
];
---
<BaseLayout title="Üretim Yöntemimiz — Kokopit ile Topraksız Tarım" description="Erusdo, kokopit (hindistan cevizi torfu) substratında topraksız tarım yapar. Kokopit yönteminin ne olduğunu, damla sulamayla üretim sürecimizi ve sağladığı hijyen, lezzet ve su verimliliği avantajlarını anlattık.">
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb"><a href={url('/')}>Anasayfa</a> / Üretim Yöntemimiz</div>
      <span class="eyebrow">Üretim Yöntemimiz</span>
      <h1 class="mt-2">Kokopit ile Topraksız Tarım</h1>
      <p class="lead mt-2" style="max-width:62ch">
        Ürünlerimizi tarla toprağı yerine kokopit (hindistan cevizi torfu)
        substratında, suyu ve besini kontrol ederek yetiştiriyoruz. Bu yöntem;
        daha hijyenik, daha lezzetli ve daha sürdürülebilir bir üretim demektir.
      </p>
    </div>
  </section>

  <!-- KOKOPİT İLE TOPRAKSIZ TARIM NEDİR -->
  <section class="section">
    <div class="container">
      <div class="grid stack-mobile" style="grid-template-columns:1.1fr 0.9fr; gap:56px; align-items:center;">
        <div class="prose" style="font-size:1.08rem">
          <h2>Kokopit ile topraksız tarım nedir?</h2>
          <p>
            Kokopit, hindistan cevizinin kabuğundan elde edilen, doğal ve
            sürdürülebilir bir yetiştirme ortamıdır. Tarla toprağının yerini alır;
            suyu ve havayı dengeli tutarak kök için ideal bir ortam sağlar.
          </p>
          <p>
            Bitkiler bu kokopit substratına dikilir, su ve besinler damla sulama
            ile doğrudan köke verilir. Toprak devreden çıktığı için topraktan
            kaynaklanan hastalıklar, yabancı otlar ve kirleticiler ortadan kalkar;
            bu da çok daha az ilaçla, kalıntısız ve hijyenik üretim demektir.
          </p>
          <p>
            Biz Erusdo olarak bu yöntemi kontrollü sera ortamıyla birleştirerek
            yıl boyu standart kalitede, taze sebze ve meyve üretiyoruz.
          </p>
        </div>
        <div class="card" style="background:linear-gradient(160deg,var(--primary-700),#0a2c1c); color:#fff; border:none;">
          <h3 style="color:#fff">Kısaca kokopit yöntemi</h3>
          <ul class="ticks mt-2" style="--c:#fff">
            <li style="color:#dceee3">Tarla toprağı yok, kokopit substratı var</li>
            <li style="color:#dceee3">Damla sulama ile su verimli üretim</li>
            <li style="color:#dceee3">Daha az ilaç, kalıntısız ürün</li>
            <li style="color:#dceee3">Yıl boyu taze hasat</li>
            <li style="color:#dceee3">Hijyenik ve sürdürülebilir</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- AVANTAJLAR -->
  <section class="section bg-soft">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Neden Kokopit?</span>
        <h2>Kokopit ile topraksız tarımın avantajları</h2>
        <p>Bu yöntem hem ürün kalitesini hem de doğayı koruyor.</p>
      </div>
      <div class="grid cols-3">
        {advantages.map((a) => (
          <div class="card">
            <div class="card-icon"><Icon name={a.icon} /></div>
            <h3 style="font-size:1.15rem">{a.title}</h3>
            <p>{a.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SÜREÇ -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Adım Adım</span>
        <h2>Fideden hasada üretim sürecimiz</h2>
        <p>Her ürün, kalite ve hijyenin garanti altına alındığı titiz bir süreçten geçer.</p>
      </div>
      <div class="grid cols-2" style="gap:14px 40px">
        <div class="steps">
          {steps.slice(0, 3).map((s) => (
            <div class="step">
              <div class="num"></div>
              <div><h3 style="font-size:1.15rem;margin-bottom:6px">{s.title}</h3><p class="muted">{s.text}</p></div>
            </div>
          ))}
        </div>
        <div class="steps" style="counter-reset: step 3">
          {steps.slice(3).map((s) => (
            <div class="step">
              <div class="num"></div>
              <div><h3 style="font-size:1.15rem;margin-bottom:6px">{s.title}</h3><p class="muted">{s.text}</p></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-soft">
    <div class="container">
      <div class="cta-band">
        <h2>Üretim seralarımızı yakından tanıyın</h2>
        <p>Ürünlerimiz ve tedarik koşulları hakkında bilgi almak, sipariş vermek ya da iş birliği için bizimle iletişime geçin.</p>
        <div class="flex gap-2 wrap" style="justify-content:center">
          <a class="btn btn-white btn-lg" href={url('/urunler')}>Ürünlerimizi Gör</a>
          <a class="btn btn-lg" href={url('/iletisim')} style="background:rgba(255,255,255,.14);color:#fff;border-color:rgba(255,255,255,.3)">İletişime Geç</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
