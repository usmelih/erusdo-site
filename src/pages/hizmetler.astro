---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { services, site } from '../data/site';
import { url } from '../utils';

const faqs = [
  { q: 'Küçük bir araziye de kurulum yapıyor musunuz?', a: 'Evet. Tek bir seradan veya birkaç dönümlük bahçeden başlayarak ölçeklenebilir çözümler sunuyoruz. Sistem ihtiyaca göre modüler büyür.' },
  { q: 'Sistem internetsiz tarlada çalışır mı?', a: 'Evet. LoRaWAN ve GSM tabanlı sensörlerimiz, sabit internet olmayan kırsal alanlarda da veri iletir. Gerektiğinde yerel ağ geçidi kurarız.' },
  { q: 'Kurulum ne kadar sürer?', a: 'Tipik bir akıllı sulama veya sensör kurulumu saha büyüklüğüne göre 1-3 gün içinde tamamlanır. Sera otomasyonu projeleri 1-2 hafta sürebilir.' },
  { q: 'Mevcut sulama altyapımla uyumlu mu?', a: 'Çoğu durumda evet. Var olan damla/yağmurlama hattınıza akıllı vana ve kontrol ünitesi ekleyerek sistemi modernize ediyoruz.' },
  { q: 'Kurulum sonrası destek veriyor musunuz?', a: 'Evet. Tüm projelerde devreye alma eğitimi, uzaktan izleme ve dönemsel bakım desteği sağlıyoruz. Bakım paketlerimizle sezon boyu yanınızdayız.' },
];
---
<BaseLayout title="Hizmetler" description="Akıllı sulama, sera otomasyonu, IoT tarla sensörleri, toprak-yaprak analizi, tarımsal danışmanlık ve drone ile izleme — Erusdo agrotech hizmetleri.">
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb"><a href={url('/')}>Anasayfa</a> / Hizmetler</div>
      <span class="eyebrow">Hizmetlerimiz</span>
      <h1 class="mt-2">Uçtan uca akıllı tarım çözümleri</h1>
      <p class="lead mt-2" style="max-width:60ch">
        Donanım, yazılım ve saha desteğini tek çatı altında topluyoruz. İşte
        arazinizin verimini artıran, maliyetinizi düşüren hizmetlerimiz.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid" style="gap:28px">
        {services.map((s, i) => (
          <article id={s.slug} class="card" style="scroll-margin-top:100px; padding:0; overflow:hidden;">
            <div class="grid" style={`grid-template-columns:${i % 2 === 0 ? '0.42fr 0.58fr' : '0.58fr 0.42fr'}; gap:0; align-items:stretch;`}>
              <div style={`order:${i % 2 === 0 ? 0 : 1}; background:linear-gradient(150deg, var(--primary), var(--primary-700)); min-height:240px; display:grid; place-items:center; position:relative;`}>
                <div style="color:#fff;text-align:center;padding:30px">
                  <div style="width:72px;height:72px;border-radius:20px;background:rgba(255,255,255,.14);display:grid;place-items:center;margin:0 auto 16px">
                    <Icon name={s.icon} style="width:36px;height:36px" />
                  </div>
                  <span style="font-family:var(--font-head);font-weight:700;letter-spacing:.1em;opacity:.8;font-size:.8rem">{String(i + 1).padStart(2, '0')}</span>
                </div>
              </div>
              <div style="padding:38px">
                <h2 style="font-size:1.6rem">{s.title}</h2>
                <p class="muted mt-2" style="font-size:1.05rem">{s.summary}</p>
                <ul class="ticks mt-3">
                  {s.features.map((f) => <li>{f}</li>)}
                </ul>
                <a class="btn btn-ghost mt-3" href={url('/iletisim')}>Bu hizmet için teklif al <Icon name="arrow" style="width:16px;height:16px" /></a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SSS -->
  <section class="section bg-soft">
    <div class="container narrow">
      <div class="section-head center">
        <span class="eyebrow">Sıkça Sorulan Sorular</span>
        <h2>Aklınıza takılanlar</h2>
      </div>
      <div class="faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-band">
        <h2>Hangi hizmetin size uygun olduğundan emin değil misiniz?</h2>
        <p>Sahanızı ücretsiz inceleyelim, önceliklerinizi birlikte belirleyelim. Size en yüksek geri dönüşü sağlayacak çözümle başlayalım.</p>
        <a class="btn btn-white btn-lg" href={url('/iletisim')}>Ücretsiz danışmanlık alın</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  })} slot="head" />
</BaseLayout>
