---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { products, site } from '../data/site';
import { url } from '../utils';

const faqs = [
  { q: 'Toptan satış yapıyor musunuz?', a: 'Evet. Market, manav, restoran, otel ve toptancılara düzenli ve standart kalitede tedarik sağlıyoruz. İhtiyacınıza göre periyodik teslimat planlayabiliriz.' },
  { q: 'Ürünleriniz organik mi?', a: 'Ürünlerimiz kokopit (hindistan cevizi torfu) substratında, topraksız yöntemle ve kontrollü sera ortamında yetişir. Bu sayede zararlı baskısı düşük olduğundan çok az ilaçla, kalıntısız üretim yapıyoruz.' },
  { q: 'Teslimat ve sevkiyat nasıl yapılıyor?', a: 'Ürünler en taze hâliyle hasat edilip hijyenik koşullarda paketlenir ve hızla sevk edilir. Bölge ve miktar bilgisiyle teslimat detaylarını birlikte planlarız.' },
  { q: 'Yıl boyu ürün bulabilir miyim?', a: 'Evet. Kontrollü sera üretimi sayesinde mevsime bağlı kalmadan, 12 ay boyunca taze ve standart kalitede ürün temin edebiliyoruz.' },
  { q: 'Minimum sipariş miktarı var mı?', a: 'Sipariş koşulları ürün ve alıcı tipine göre değişir. En doğru bilgi için bizimle iletişime geçmeniz yeterli; size özel bir tedarik planı çıkaralım.' },
];
---
<BaseLayout title="Ürünlerimiz" description="Erusdo'nun kokopit ile topraksız tarımla ürettiği taze ve hijyenik ürünler: kıvırcık marul, marul, lollo rosso ve çilek. Toptan tedarik.">
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb"><a href={url('/')}>Anasayfa</a> / Ürünlerimiz</div>
      <span class="eyebrow">Ürünlerimiz</span>
      <h1 class="mt-2">Serada özenle yetişen taze ürünler</h1>
      <p class="lead mt-2" style="max-width:60ch">
        Kokopit ile topraksız tarım yöntemiyle yetiştirdiğimiz, kalıntısız ve yıl
        boyu taze ürünlerimiz. Tümü hijyenik koşullarda üretilir, en taze hâliyle
        sofranıza ulaşır.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid" style="gap:28px">
        {products.map((s, i) => (
          <article id={s.slug} class="card" style="scroll-margin-top:100px; padding:0; overflow:hidden;">
            <div class="grid stack-mobile" style={`grid-template-columns:${i % 2 === 0 ? '0.42fr 0.58fr' : '0.58fr 0.42fr'}; gap:0; align-items:stretch;`}>
              <div class="prod-media" style={`order:${i % 2 === 0 ? 0 : 1}; min-height:240px; position:relative; overflow:hidden;`}>
                <img src={url(s.image)} alt={`${s.title} — Erusdo'nun kokopit ile topraksız tarımla ürettiği taze ${s.title.toLowerCase()}`} loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" />
                <span style="position:absolute;left:16px;bottom:14px;background:rgba(12,44,29,.72);color:#fff;font-family:var(--font-head);font-weight:700;letter-spacing:.06em;font-size:.78rem;padding:6px 13px;border-radius:100px;backdrop-filter:blur(4px)">{s.title.toUpperCase()}</span>
              </div>
              <div style="padding:38px">
                <h2 style="font-size:1.6rem">{s.title}</h2>
                <p class="muted mt-2" style="font-size:1.05rem">{s.summary}</p>
                <ul class="ticks mt-3">
                  {s.features.map((f) => <li>{f}</li>)}
                </ul>
                <a class="btn btn-ghost mt-3" href={url('/iletisim')}>Bu ürün için sipariş/teklif <Icon name="arrow" style="width:16px;height:16px" /></a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <p class="center muted mt-4" style="font-size:.95rem">
        Ürün gamımız mevsime ve üretim planına göre genişleyebilir. Aradığınız bir ürün için
        <a href={url('/iletisim')} style="color:var(--primary);font-weight:600">bize danışın</a>.
      </p>
    </div>
  </section>

  <!-- SSS -->
  <section class="section bg-soft">
    <div class="container narrow">
      <div class="section-head center">
        <span class="eyebrow">Sıkça Sorulan Sorular</span>
        <h2>Sipariş & tedarik hakkında</h2>
      </div>
      <div class="faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-band">
        <h2>Düzenli, taze tedarik için bize ulaşın</h2>
        <p>Market, manav, restoran ve toptan alıcılar için standart kalitede ürün sağlıyoruz. Size özel tedarik planı için iletişime geçin.</p>
        <a class="btn btn-white btn-lg" href={url('/iletisim')}>Sipariş & Teklif Al</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  })} slot="head" />
</BaseLayout>
