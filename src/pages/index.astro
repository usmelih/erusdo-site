---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site, products, stats, mapEmbedSrc } from '../data/site';
import { url, formatDate } from '../utils';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const why = [
  { icon: 'seedling', title: 'Kokopit ile Topraksız Üretim', text: 'Ürünlerimiz tarla toprağıyla temas etmeden, kokopit (hindistan cevizi torfu) substratında yetişir. Daha temiz, daha hijyenik, daha sağlıklı.' },
  { icon: 'shield', title: 'Kalıntısız & Az İlaçlı', text: 'Kontrollü sera ortamı, zararlı baskısını en aza indirir. Böylece çok daha az ilaçla, kalıntısız ürün üretiriz.' },
  { icon: 'sun', title: 'Yıl Boyu Taze', text: 'Mevsim koşullarına bağlı kalmadan, 12 ay boyunca taze ve standart kalitede hasat yaparız. Tedarikte süreklilik.' },
  { icon: 'droplet', title: 'Su Dostu & Sürdürülebilir', text: 'Kokopitin yüksek su tutma kapasitesi ve damla sulama, suyu doğrudan köke ölçülü verir; çok daha az suyla, doğaya saygılı üretim.' },
];

const steps = [
  { title: 'Sağlıklı Fideyle Başlangıç', text: 'Üretime, hastalıksız ve güçlü fidelerle başlıyoruz. Doğru çeşit seçimi, kaliteli hasadın ilk adımıdır.' },
  { title: 'Kokopite Dikim', text: 'Fideler, tarla toprağı yerine kokopit dolu torba ve saksılara dikilir; kök için suyu ve havayı dengede tutan hijyenik bir ortam sağlanır.' },
  { title: 'Damla Sulama ile Besleme', text: 'Su ve besinler, damla sulama ile doğrudan köke verilir; her bitki tam ihtiyacı kadar, ölçülü beslenir.' },
  { title: 'Hijyenik Hasat & Paketleme', text: 'Ürünleri en taze hâliyle, hijyen kurallarına uygun toplar, özenle paketleyip hızla sevk ederiz.' },
];
---
<BaseLayout>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow"><Icon name="leaf" style="width:15px;height:15px" /> Kokopit ile Topraksız Tarım · Çine / Aydın</span>
        <h1>Kokopitte topraksız yetişen <span style="color:var(--primary)">tertemiz</span> sebze ve meyve</h1>
        <p class="lead">
          Erusdo, modern seralarında kokopit (hindistan cevizi torfu) substratında
          topraksız tarım yöntemiyle taze, hijyenik ve lezzetli ürünler üretir.
          Damla sulamayla su verimli, daha az ilaç, yıl boyu aynı kalite.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary btn-lg" href={url('/urunler')}>Ürünlerimizi İnceleyin <Icon name="arrow" style="width:18px;height:18px" /></a>
          <a class="btn btn-ghost btn-lg" href={url('/iletisim')}>Toptan & Sipariş</a>
        </div>
        <div class="hero-trust">
          {stats.slice(0, 3).map((s) => (
            <div><strong>{s.value}</strong>{s.label}</div>
          ))}
        </div>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <svg class="leafpattern" viewBox="0 0 400 400" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
          <defs><pattern id="p" width="48" height="48" patternUnits="userSpaceOnUse">
            <path d="M24 8c-9 0-16 6-16 16 0 9 7 16 16 16 0-8 0-16-10-22 9 1 13 6 16 12 1-2 1-4 1-6 0-9-6-16-7-16Z" fill="#ffffff"/>
          </pattern></defs>
          <rect width="400" height="400" fill="url(#p)"/>
        </svg>
        <div class="hero-card c1">
          <span class="dot" style="background:var(--accent-soft);color:#5a7a18"><Icon name="seedling" style="width:22px;height:22px" /></span>
          <div><b>Kokopit</b><span>Hijyenik kök ortamı</span></div>
        </div>
        <div class="hero-card c2">
          <span class="dot" style="background:var(--primary-tint);color:var(--primary)"><Icon name="droplet" style="width:22px;height:22px" /></span>
          <div><b>Besin dengede</b><span>Bitkiye tam ihtiyacı kadar</span></div>
        </div>
        <div class="hero-card c3">
          <span class="dot" style="background:var(--amber-soft);color:var(--amber)"><Icon name="sun" style="width:22px;height:22px" /></span>
          <div><b>Sera: 24°C</b><span>İklim kontrollü</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- GÜVEN ŞERİDİ -->
  <section class="section-sm bg-soft">
    <div class="container">
      <p class="center muted" style="margin-bottom:22px; font-size:.92rem; letter-spacing:.04em;">MARKETLERİN, MANAVLARIN VE RESTORANLARIN TAZE TEDARİKÇİSİ</p>
      <div class="logos">
        <span>Marketler</span><span>Manavlar</span><span>Restoranlar</span><span>Oteller</span><span>Toptancılar</span><span>Hal Esnafı</span>
      </div>
    </div>
  </section>

  <!-- ÜRÜNLER -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Ürünlerimiz</span>
        <h2>Topraktan değil, özenden gelen lezzet</h2>
        <p>Serada, kontrollü koşullarda yetiştirdiğimiz taze ve hijyenik ürünlerimiz. Tümü kalıntısız, yıl boyu taze.</p>
      </div>
      <div class="grid cols-3">
        {products.map((s) => (
          <article class="card">
            <div class="card-icon"><Icon name={s.icon} /></div>
            <h3>{s.title}</h3>
            <p>{s.summary}</p>
            <a class="readmore mt-3" href={url(`/urunler#${s.slug}`)} style="font-family:var(--font-head);font-weight:600;color:var(--primary);display:inline-flex;gap:6px;align-items:center;">
              Detaylar <Icon name="arrow" style="width:16px;height:16px" />
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- NEDEN ERUSDO -->
  <section class="section bg-soft">
    <div class="container">
      <div class="grid stack-mobile" style="grid-template-columns: 0.9fr 1.1fr; gap:48px; align-items:center;">
        <div>
          <span class="eyebrow">Neden Erusdo?</span>
          <h2 class="mt-2">Daha temiz bir tabak için</h2>
          <p class="lead mt-2">
            Kokopit ile topraksız tarım sadece bir yöntem değil, bir kalite
            taahhüdüdür. Suyu ve besini kontrol ederek; hijyenik, kalıntısız ve her
            zaman taze ürünler üretiyoruz. Sofranıza gelen her ürünün arkasında özen var.
          </p>
          <a class="btn btn-primary mt-4" href={url('/uretim-yontemimiz')}>Üretim yöntemimizi keşfedin</a>
        </div>
        <div class="grid cols-2">
          {why.map((w) => (
            <div class="card">
              <div class="card-icon"><Icon name={w.icon} /></div>
              <h3 style="font-size:1.15rem">{w.title}</h3>
              <p>{w.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ÜRETİM SÜRECİ -->
  <section class="section">
    <div class="container">
      <div class="grid stack-mobile" style="grid-template-columns: 0.8fr 1.2fr; gap:56px;">
        <div class="section-head" style="margin-bottom:0">
          <span class="eyebrow">Tohumdan Sofraya</span>
          <h2 class="mt-2">Üretim sürecimiz</h2>
          <p>Her ürün, fideden hasada kadar titizlikle takip edilen 4 aşamadan geçer.</p>
        </div>
        <div class="steps">
          {steps.map((s) => (
            <div class="step">
              <div class="num"></div>
              <div>
                <h3 style="font-size:1.2rem; margin-bottom:6px;">{s.title}</h3>
                <p class="muted">{s.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- İSTATİSTİK BANDI -->
  <section class="section bg-dark">
    <div class="container">
      <div class="section-head center" style="margin-bottom:40px">
        <h2>Rakamlarla Erusdo</h2>
        <p>Modern sera üretiminin sağladığı somut farklar.</p>
      </div>
      <div class="stats">
        {stats.map((s) => (
          <div class="stat"><b>{s.value}</b><span>{s.label}</span></div>
        ))}
      </div>
    </div>
  </section>

  <!-- REFERANS -->
  <section class="section">
    <div class="container narrow center">
      <Icon name="quote" class="" style="width:44px;height:44px;color:var(--accent);margin-inline:auto" />
      <p style="font-family:var(--font-head); font-size:clamp(1.3rem,3vw,1.9rem); font-weight:600; line-height:1.4; margin:20px 0 24px; letter-spacing:-0.02em;">
        “Erusdo’dan aldığımız marul ve yeşillikler hem çok daha taze duruyor hem
        de müşterilerimiz lezzetini fark ediyor. Tedarikte hiç aksama yaşamadık,
        kalite her zaman aynı.”
      </p>
      <div class="flex items-center gap-2" style="justify-content:center">
        <div style="width:48px;height:48px;border-radius:50%;background:var(--primary-tint);display:grid;place-items:center;font-family:var(--font-head);font-weight:800;color:var(--primary)">AY</div>
        <div style="text-align:left">
          <b style="font-family:var(--font-head)">Ahmet Yılmaz</b><br>
          <span class="muted" style="font-size:.9rem">Market Sahibi · Aydın</span>
        </div>
      </div>
    </div>
  </section>

  <!-- BLOG -->
  <section class="section bg-soft">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Bilgi Bankası</span>
        <h2>Tarım & Yetiştiricilik Blogu</h2>
        <p>Topraksız tarım, sera, sağlıklı üretim ve agrotech üzerine pratik bilgiler ve güncel içerikler.</p>
      </div>
      <div class="grid cols-3">
        {posts.map((post) => (
          <article class="card post-card">
            <a href={url(`/blog/${post.slug}`)} class="thumb" style={`background:linear-gradient(150deg, ${post.data.coverColor}, var(--primary-700))`}>
              <span>{post.data.title.charAt(0)}</span>
            </a>
            <div class="body">
              <div class="post-meta"><span class="tag">{post.data.category}</span><span>{formatDate(post.data.pubDate)}</span></div>
              <h3><a href={url(`/blog/${post.slug}`)}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
              <a class="readmore" href={url(`/blog/${post.slug}`)}>Devamını oku <Icon name="arrow" style="width:15px;height:15px" /></a>
            </div>
          </article>
        ))}
      </div>
      <div class="center mt-4">
        <a class="btn btn-ghost" href={url('/blog')}>Tüm yazıları gör</a>
      </div>
    </div>
  </section>

  <!-- KONUM / HARİTA (local SEO) -->
  <section class="section" id="konum">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow"><Icon name="pin" style="width:15px;height:15px" /> Konum</span>
        <h2>Bizi Çine, Aydın'da bulun</h2>
        <p>Üretim seralarımız {site.address.district}/{site.address.city}'da. Toptan alım, sipariş veya ziyaret için bize ulaşın.</p>
      </div>
      <div class="grid stack-mobile" style="grid-template-columns: 0.9fr 1.5fr; gap:32px; align-items:stretch;">
        <div class="card" style="display:flex;flex-direction:column;justify-content:center">
          <div class="info-row">
            <span class="ic"><Icon name="pin" /></span>
            <div><b>Adres</b><a href={site.mapDirectionsUrl} target="_blank" rel="noopener">{site.address.full}</a></div>
          </div>
          <div class="info-row">
            <span class="ic"><Icon name="phone" /></span>
            <div><b>Telefon</b><a href={site.phoneHref}>{site.phone}</a></div>
          </div>
          <div class="info-row">
            <span class="ic"><Icon name="clock" /></span>
            <div><b>Çalışma Saatleri</b>{site.hours.map((h) => <span style="display:block">{h.day}: {h.time}</span>)}</div>
          </div>
          <a class="btn btn-primary mt-3" href={site.mapDirectionsUrl} target="_blank" rel="noopener"><Icon name="pin" style="width:18px;height:18px" /> Yol Tarifi Al</a>
        </div>
        <iframe
          class="map-embed"
          style="height:100%;min-height:360px"
          src={mapEmbedSrc}
          title={`${site.legalName} konumu — ${site.address.full}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-soft">
    <div class="container">
      <div class="cta-band">
        <h2>Taze ve hijyenik ürün mü arıyorsunuz?</h2>
        <p>Market, manav, restoran ve toptan alıcılar için düzenli ve standart kalitede tedarik sağlıyoruz. Sipariş ve fiyat için hemen ulaşın.</p>
        <div class="flex gap-2 wrap" style="justify-content:center">
          <a class="btn btn-white btn-lg" href={url('/iletisim')}>Sipariş & Teklif Al</a>
          <a class="btn btn-lg" href={site.whatsappHref} target="_blank" rel="noopener" style="background:rgba(255,255,255,.14);color:#fff;border-color:rgba(255,255,255,.3)">
            <Icon name="whatsapp" style="width:18px;height:18px" /> WhatsApp’tan yazın
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
